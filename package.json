{
  "name": "bdeck",
  "private": true,
  "scripts": {
    "dev": "vp -C desktop run dev",
    "build": "vp -C desktop run build",
    "frame:dev": "vp -C frame run dev",
    "frame:build": "vp -C frame run build",
    "check": "vp -C frame check --deny-warnings",
    "format": "vp fmt vite.config.ts package.json frame/package.json frame --write",
    "format:check": "vp fmt --check vite.config.ts package.json frame/package.json",
    "lint": "vp -C frame lint --deny-warnings",
    "knip": "knip --include dependencies --no-progress"
  },
  "devDependencies": {
    "knip": "6.45.1",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "packageManager": "pnpm@11.17.0"
}
