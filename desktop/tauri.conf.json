{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BDeck",
  "identifier": "app.bdeck",
  "build": {
    "beforeDevCommand": "pnpm --dir ../frame dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../frame build",
    "frontendDist": "../frame/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "BDeck",
        "width": 1200,
        "height": 800,
        "minWidth": 680,
        "minHeight": 480,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "trafficLightPosition": {
          "x": 7,
          "y": 22
        },
        "url": "browser.html"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: zephium-media: http://zephium-media.localhost https://pbs.twimg.com/profile_images/",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "child-src": "'none'",
        "frame-src": "'none'",
        "media-src": "'none'",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: zephium-media: http://zephium-media.localhost https://pbs.twimg.com/profile_images/",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "child-src": "'none'",
        "frame-src": "'none'",
        "media-src": "'none'",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "BDeck",
    "copyright": "Copyright © 2026 BDeck contributors",
    "category": "Productivity",
    "shortDescription": "A native X column dashboard.",
    "license": "MPL-2.0",
    "resources": {
      "../LICENSE": "licenses/BDeck-MPL-2.0.txt"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzQTAxNTgwMDkxQzlFNkEKUldScW5od0pnQldnVTB5d1RCYng1MG02WUN6MGphNDNwdE5IRUx1bFlVd1lTcEptRFMxR3VTMTIK",
      "endpoints": [
        "https://github.com/AkaakuHub/BDeck/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
